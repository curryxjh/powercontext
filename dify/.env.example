# 忘川当铺 · 适配层配置示例
# 复制为 .env 后按需修改；不要提交真实令牌。

# PowerContext Server 地址（末尾不要带 /）
POWERCONTEXT_URL=http://127.0.0.1:8000

# 仅当 PowerContext 开启了 Bearer 鉴权时填写；默认关闭时留空。
# POWERCONTEXT_TOKEN=replace-with-your-token

# 单次 PowerContext 请求超时（秒）
POWERCONTEXT_TIMEOUT=15

# 玩家外部引用类型，会写进 PowerContext scope 的 external_references[].kind
PAWN_EXTERNAL_KIND=wangchuan.player

# 适配层监听地址与端口。
# 0.0.0.0 便于 Docker 内的 Dify 通过 host.docker.internal 访问；
# 适配层本身不做鉴权，请只在可信网络中使用，或改为 127.0.0.1。
PAWN_HOST=0.0.0.0
PAWN_PORT=8787
PAWN_LOG_LEVEL=info
