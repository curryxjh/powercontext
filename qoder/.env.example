# WenGu runtime settings. Copy to .env or export in your shell.
# No API key is needed: PowerContext runs embedded with local SQLite.

WENGU_HOST=127.0.0.1
WENGU_PORT=8010
WENGU_DATA_DIR=./data
WENGU_TIMEZONE=Asia/Shanghai

# Seed a reproducible demo learner on first start (1) or start empty (0).
WENGU_AUTO_SEED=1

WENGU_DEFAULT_DAILY_MINUTES=20
WENGU_DEFAULT_STYLE=图示 + 生活类比
WENGU_MAX_IMPORT_CHARS=120000
WENGU_MAX_ANSWER_BYTES=6000

# Set to 1 for auto-reload during development.
WENGU_RELOAD=0
